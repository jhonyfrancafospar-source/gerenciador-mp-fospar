# Neon API Key (opcional, Neon Console: Account Settings -> API Keys)
NEON_API_KEY=

# Neon PostgreSQL connection string (Neon Console: Dashboard -> Connection Details)
# Formato: postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Neon Object Storage (Credenciais S3-compatíveis do Neon)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL_S3=
AWS_S3_BUCKET=
